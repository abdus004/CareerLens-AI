# Local development default - the FastAPI backend running on your machine.
# In Vercel, set VITE_API_URL as a Project Environment Variable (Settings ->
# Environment Variables) pointing at your deployed backend's public HTTPS URL.
# Vercel's env var overrides this file's value at build time, so .env itself
# does not need to change for production - it's only used for local `npm run dev`.
VITE_API_URL=http://127.0.0.1:8000
