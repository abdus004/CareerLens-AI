# Required Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-server-side-supabase-key

# Gemini keys used by AI-powered features
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_API_KEY_3=your-gemini-api-key-3
GEMINI_API_KEY_4=your-gemini-api-key-4
GEMINI_API_KEY_5=your-gemini-api-key-5
GEMINI_API_KEY_6=your-gemini-api-key-6

# Optional comma-separated frontend origins in addition to backend defaults
FRONTEND_ORIGINS=https://your-frontend.example.com
